{
  "name": "d3-link-area",
  "version": "0.1.0",
  "description": "Links drawn as areas for D3, the filled counterpart of d3.link: Sankey and alluvial ribbons with constant perpendicular thickness and variable width.",
  "keywords": [
    "d3",
    "d3-module",
    "shape",
    "link",
    "sankey",
    "alluvial",
    "flow",
    "ribbon"
  ],
  "homepage": "https://github.com/mikima/d3-link-area",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikima/d3-link-area.git"
  },
  "bugs": {
    "url": "https://github.com/mikima/d3-link-area/issues"
  },
  "license": "ISC",
  "author": "Michele Mauri",
  "type": "module",
  "files": [
    "dist/**/*.js",
    "src/**/*.js",
    "index.d.ts"
  ],
  "module": "src/index.js",
  "main": "src/index.js",
  "jsdelivr": "dist/d3-link-area.min.js",
  "unpkg": "dist/d3-link-area.min.js",
  "types": "index.d.ts",
  "exports": {
    "types": "./index.d.ts",
    "umd": "./dist/d3-link-area.min.js",
    "default": "./src/index.js"
  },
  "sideEffects": false,
  "dependencies": {
    "d3-path": "1 - 3"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "d3-shape": "^3.2.0",
    "rollup": "^4.0.0"
  },
  "scripts": {
    "test": "node --test 'test/**/*-test.js'",
    "build": "rollup -c",
    "prepublishOnly": "npm test && npm run build"
  },
  "engines": {
    "node": ">=18"
  }
}
